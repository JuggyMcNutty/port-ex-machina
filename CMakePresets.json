{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "port",
      "hidden": true,
      "description": "One preset per ports/<id>/; the preset name is the port id.",
      "binaryDir": "${sourceDir}/build/${presetName}/launcher",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DXL_PORT": "${presetName}"
      }
    },
    {
      "name": "linux-x86_64",
      "inherits": "port",
      "displayName": "Linux x86_64 (native; tests and dxl-shots)"
    },
    {
      "name": "linux-aarch64",
      "inherits": "port",
      "displayName": "Linux aarch64 (cross from a PC, native on aarch64)",
      "toolchainFile": "${sourceDir}/ports/linux-aarch64/toolchain-c.cmake"
    },
    {
      "name": "trimui-smartpro",
      "inherits": "port",
      "displayName": "TrimUI Smart Pro (spruceOS, cross)",
      "toolchainFile": "${sourceDir}/ports/trimui-smartpro/toolchain-c.cmake"
    }
  ],
  "buildPresets": [
    { "name": "linux-x86_64",    "configurePreset": "linux-x86_64" },
    { "name": "linux-aarch64",   "configurePreset": "linux-aarch64" },
    { "name": "trimui-smartpro", "configurePreset": "trimui-smartpro" }
  ],
  "testPresets": [
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "output": { "outputOnFailure": true }
    }
  ]
}
