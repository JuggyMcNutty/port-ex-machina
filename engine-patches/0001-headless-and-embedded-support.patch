diff --git a/SurrealEngine/GameApp.cpp b/SurrealEngine/GameApp.cpp
index 3b059e5..7335139 100644
--- a/SurrealEngine/GameApp.cpp
+++ b/SurrealEngine/GameApp.cpp
@@ -12,16 +12,30 @@
 #include "Utils/File.h"
 #include <stdexcept>
 #include <iostream>
+#include "Utils/Logger.h"
 
 int GameApp::main(Array<std::string> args)
 {
 	InitWidgetResources("dark");
+	int exitcode = 0;
 
 	try
 	{
 		CommandLine cmd(args);
 		commandline = &cmd;
 
+		// Stream the engine log to stderr in headless mode. Without this the
+		// log only surfaces inside the modal error window, which is no use on
+		// a test rig or an embedded target -- and LogUnimplemented() is exactly
+		// how we find out which natives a game still needs.
+		if (commandline->HasArg("-n", "--no-launcher") || commandline->HasArg("-v", "--verbose"))
+		{
+			Logger::Get()->SetCallback([](const LogMessageLine& line)
+			{
+				std::cerr << "[" << line.Source << "] " << line.Text << std::endl;
+			});
+		}
+
 		if (ErrorWindow::CheckCrashReporter())
 			return 0;
 
@@ -31,7 +45,33 @@ int GameApp::main(Array<std::string> args)
 			return 0;
 		}
 
-		int selectedGameIndex = LauncherWindow::ExecModal();
+		// Skip the desktop launcher window when a game folder is given on the
+		// command line, or when --no-launcher is passed.
+		//
+		// Needed twice over: it is the only way to drive the engine headlessly
+		// for testing, and the handheld target has no mouse and no desktop --
+		// game selection happens in our own launcher before this process starts.
+		int selectedGameIndex;
+		if (!commandline->GetItems().empty() || commandline->HasArg("-n", "--no-launcher"))
+		{
+			GameFolderSelection::UpdateList();
+			if (GameFolderSelection::Games.empty())
+			{
+				std::cout << "No UE1 game found in the given folder." << std::endl;
+				selectedGameIndex = -1;
+			}
+			else
+			{
+				selectedGameIndex = 0;
+				std::cout << "Launching " << GameFolderSelection::Games[0].gameName
+				          << " " << GameFolderSelection::Games[0].gameVersionString
+				          << std::endl;
+			}
+		}
+		else
+		{
+			selectedGameIndex = LauncherWindow::ExecModal();
+		}
 		if (selectedGameIndex >= 0)
 		{
 			GameLaunchInfo info = GameFolderSelection::GetLaunchInfo(selectedGameIndex);
@@ -41,9 +81,17 @@ int GameApp::main(Array<std::string> args)
 	}
 	catch (const std::exception& e)
 	{
-		ErrorWindow::ExecModal(e.what(), Logger::Get()->GetLog());
+		// Always report to stderr as well as the GUI. On a headless test rig or
+		// an embedded target there may be no window to read the message in, and
+		// a modal error window with nobody to close it just spins.
+		exitcode = 1;
+		std::cerr << "SurrealEngine error: " << e.what() << std::endl;
+		for (const LogMessageLine& line : Logger::Get()->GetLog())
+			std::cerr << "  log: " << line.Text << std::endl;
+		if (!commandline || !commandline->HasArg("-n", "--no-launcher"))
+			ErrorWindow::ExecModal(e.what(), Logger::Get()->GetLog());
 	}
 
 	DeinitWidgetResources();
-	return 0;
+	return exitcode;
 }
diff --git a/SurrealWidgets/CMakeLists.txt b/SurrealWidgets/CMakeLists.txt
index 909eced..dc2f374 100644
--- a/SurrealWidgets/CMakeLists.txt
+++ b/SurrealWidgets/CMakeLists.txt
@@ -12,22 +12,35 @@ else()
 	option(ENABLE_SDL2 "Enable SDL2 backend. Optional on all platforms" ON)
 endif()
 
+# An embedded target (a handheld running a vendor SDL2 over EGL/Vulkan) has no
+# X11, no Wayland compositor, no dbus and no desktop GL. Turning those backends
+# off lets the library build against such a sysroot; window.cpp already has
+# null-returning stubs for every backend whose USE_* define is absent.
+option(ENABLE_X11 "Enable the X11 display backend" ON)
+option(ENABLE_WAYLAND "Enable the Wayland display backend" ON)
+
 if (UNIX AND NOT APPLE)
 	include(FindPkgConfig)
-	pkg_check_modules(DBUS dbus-1)
-	if (!DBUS_FOUND)
-		pkg_check_modules(DBUS REQUIRED dbus) # Fedora Linux looks for dbus instead
+	if (ENABLE_X11 OR ENABLE_WAYLAND)
+		pkg_check_modules(DBUS dbus-1)
+		if (NOT DBUS_FOUND)
+			pkg_check_modules(DBUS dbus) # Fedora Linux looks for dbus instead
+		endif()
+		# EGL is how the X11 and Wayland backends get a GL context. Not required:
+		# an SDL2-only build never asks for one.
+		find_package(OpenGL COMPONENTS EGL)
+	endif()
+	if (ENABLE_WAYLAND)
+		pkg_check_modules(WAYLANDPP
+			wayland-client
+			wayland-client++
+			wayland-client-extra++
+			wayland-client-unstable++
+			wayland-cursor++
+			wayland-egl++
+			xkbcommon>=0.5.0
+		)
 	endif()
-	find_package(OpenGL REQUIRED COMPONENTS EGL)
-	pkg_check_modules(WAYLANDPP
-		wayland-client
-		wayland-client++
-		wayland-client-extra++
-		wayland-client-unstable++
-		wayland-cursor++
-		wayland-egl++
-		xkbcommon>=0.5.0
-	)
 	pkg_check_modules(GLIB glib-2.0)
 	pkg_check_modules(FONTCONFIG fontconfig)
 endif()
@@ -363,10 +376,14 @@ elseif(HAIKU)
 	set(SURREALWIDGETS_LINK_OPTIONS -pthread)
 else()
 	set(SURREALWIDGETS_SOURCES ${SURREALWIDGETS_SOURCES} ${SURREALWIDGETS_UNIX_SOURCES})
-	set(SURREALWIDGETS_SOURCES ${SURREALWIDGETS_SOURCES} ${SURREALWIDGETS_X11_SOURCES})
-	set(SURREALWIDGETS_LIBS ${CMAKE_DL_LIBS} -lX11 -lXi)
-	set(SURREALWIDGETS_DEFINES -DUNIX -D_UNIX -DUSE_X11)
+	set(SURREALWIDGETS_LIBS ${CMAKE_DL_LIBS})
+	set(SURREALWIDGETS_DEFINES -DUNIX -D_UNIX)
 	set(SURREALWIDGETS_LINK_OPTIONS -pthread)
+	if (ENABLE_X11)
+		set(SURREALWIDGETS_SOURCES ${SURREALWIDGETS_SOURCES} ${SURREALWIDGETS_X11_SOURCES})
+		set(SURREALWIDGETS_LIBS ${SURREALWIDGETS_LIBS} -lX11 -lXi)
+		set(SURREALWIDGETS_DEFINES ${SURREALWIDGETS_DEFINES} -DUSE_X11)
+	endif()
 	if (DBUS_FOUND)
 		include_directories("/usr/lib64/dbus-1.0/include") # Bazzite (and probably Fedora 42) keeps the platform-specific dbus headers in this folder
 		set(SURREALWIDGETS_SOURCES ${SURREALWIDGETS_SOURCES} ${SURREALWIDGETS_DBUS_SOURCES})
@@ -385,11 +402,14 @@ else()
 		set(SURREALWIDGETS_DEFINES ${SURREALWIDGETS_DEFINES} -DUSE_WAYLAND)
 	endif()
 
-	set(SURREALWIDGETS_INCLUDE_DIRS ${SURREALWIDGETS_INCLUDE_DIRS} ${GLIB_INCLUDE_DIRS})
-	set(SURREALWIDGETS_LIBS ${SURREALWIDGETS_LIBS} ${GLIB_LDFLAGS} -lgio-2.0)
-
-	set(SURREALWIDGETS_INCLUDE_DIRS ${SURREALWIDGETS_INCLUDE_DIRS} ${FONTCONFIG_INCLUDE_DIRS})
-	set(SURREALWIDGETS_LIBS ${SURREALWIDGETS_LIBS} ${FONTCONFIG_LDFLAGS})
+	# The system-font lookup asks GSettings what the desktop UI font is and
+	# resolves it with fontconfig. With neither available, resourcedata_unix.cpp
+	# falls back to the fonts the device actually ships.
+	if (GLIB_FOUND AND FONTCONFIG_FOUND)
+		set(SURREALWIDGETS_INCLUDE_DIRS ${SURREALWIDGETS_INCLUDE_DIRS} ${GLIB_INCLUDE_DIRS} ${FONTCONFIG_INCLUDE_DIRS})
+		set(SURREALWIDGETS_LIBS ${SURREALWIDGETS_LIBS} ${GLIB_LDFLAGS} -lgio-2.0 ${FONTCONFIG_LDFLAGS})
+		set(SURREALWIDGETS_DEFINES ${SURREALWIDGETS_DEFINES} -DSURREALWIDGETS_DESKTOP_FONTS)
+	endif()
 endif()
 
 if(SDL3_FOUND)
@@ -420,10 +440,17 @@ if(APPLE)
 else()
 	target_link_libraries(surrealwidgets PRIVATE ${SURREALWIDGETS_LIBS})
 endif()
+# SDL can arrive either from find_package (which defines the imported target
+# and SDLn_LIBRARY) or from pkg-config (which defines SDLn_LIBRARIES instead).
+# Cross builds take the pkg-config path, where SDLn_LIBRARY is empty -- so try
+# all three rather than only the first two.
 if(SDL3_FOUND)
 	target_include_directories(surrealwidgets PRIVATE ${SDL3_INCLUDE_DIRS})
 	if(TARGET SDL3::SDL3)
 		target_link_libraries(surrealwidgets PRIVATE SDL3::SDL3)
+	elseif(SDL3_LIBRARIES)
+		target_link_libraries(surrealwidgets PRIVATE ${SDL3_LIBRARIES})
+		target_link_directories(surrealwidgets PRIVATE ${SDL3_LIBRARY_DIRS})
 	else()
 		target_link_libraries(surrealwidgets PRIVATE ${SDL3_LIBRARY})
 	endif()
@@ -432,6 +459,9 @@ if(SDL2_FOUND AND NOT SDL3_FOUND)
 	target_include_directories(surrealwidgets PRIVATE ${SDL2_INCLUDE_DIRS})
 	if(TARGET SDL2::SDL2)
 		target_link_libraries(surrealwidgets PRIVATE SDL2::SDL2)
+	elseif(SDL2_LIBRARIES)
+		target_link_libraries(surrealwidgets PRIVATE ${SDL2_LIBRARIES})
+		target_link_directories(surrealwidgets PRIVATE ${SDL2_LIBRARY_DIRS})
 	else()
 		target_link_libraries(surrealwidgets PRIVATE ${SDL2_LIBRARY})
 	endif()
diff --git a/SurrealWidgets/src/core/resourcedata_unix.cpp b/SurrealWidgets/src/core/resourcedata_unix.cpp
index 03e659e..fda08a5 100644
--- a/SurrealWidgets/src/core/resourcedata_unix.cpp
+++ b/SurrealWidgets/src/core/resourcedata_unix.cpp
@@ -4,8 +4,13 @@
 #include <vector>
 #include <string>
 #include <cmath>
+#ifdef SURREALWIDGETS_DESKTOP_FONTS
 #include <gio/gio.h>
 #include <fontconfig/fontconfig.h>
+#else
+#include <cstdlib>
+#include <sys/stat.h>
+#endif
 
 static std::vector<uint8_t> ReadAllBytes(const std::string& filename)
 {
@@ -23,6 +28,8 @@ static std::vector<uint8_t> ReadAllBytes(const std::string& filename)
 	return buffer;
 }
 
+#ifdef SURREALWIDGETS_DESKTOP_FONTS
+
 static std::vector<SingleFontData> GetGtkUIFont(const std::string& propertyName)
 {
 	// Ask GTK what the UI font is:
@@ -65,6 +72,47 @@ static std::vector<SingleFontData> GetGtkUIFont(const std::string& propertyName)
 	return { std::move(fontdata) };
 }
 
+#else
+
+// No desktop session to ask. An embedded target has no GSettings schema and no
+// fontconfig configuration, so the UI font is whatever the device actually
+// ships. Overridable so a packager does not have to patch this list.
+static std::vector<SingleFontData> GetGtkUIFont(const std::string& propertyName)
+{
+	const bool monospace = (propertyName.find("monospace") != std::string::npos);
+
+	const char* envName = monospace ? "SURREALWIDGETS_MONOSPACE_FONT" : "SURREALWIDGETS_FONT";
+	const char* override = std::getenv(envName);
+
+	std::vector<std::string> candidates;
+	if (override && *override)
+		candidates.push_back(override);
+
+	// TrimUI / spruceOS
+	candidates.push_back("/usr/trimui/res/regular.ttf");
+	candidates.push_back("/usr/trimui/res/full.ttf");
+	candidates.push_back("/mnt/SDCARD/spruce/Font Files/Noto.ttf");
+	// Ordinary Linux installs, so a desktop build without glib still works
+	candidates.push_back("/usr/share/fonts/TTF/DejaVuSans.ttf");
+	candidates.push_back("/usr/share/fonts/dejavu/DejaVuSans.ttf");
+	candidates.push_back("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
+	candidates.push_back("/usr/share/fonts/noto/NotoSans-Regular.ttf");
+
+	for (const std::string& path : candidates)
+	{
+		struct stat st;
+		if (stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode))
+		{
+			SingleFontData fontdata;
+			fontdata.fontdata = ReadAllBytes(path);
+			return { std::move(fontdata) };
+		}
+	}
+	throw std::runtime_error("No usable UI font found; set " + std::string(envName));
+}
+
+#endif
+
 std::vector<SingleFontData> ResourceData::LoadSystemFont()
 {
 	return GetGtkUIFont("font-name");
