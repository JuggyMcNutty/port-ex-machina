 	{
 		if (face.MaterialIndex >= mesh->Materials.size())
@@ -1044,6 +1058,10 @@ bool VisibleMesh::DrawLodMeshFaceDX(VisibleFrame* frame, UActor* actor, UActor*
 			continue;
 		}
 
