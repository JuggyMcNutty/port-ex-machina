From 2d315e3602663f73f802a25a58c282ae545dafec Mon Sep 17 00:00:00 2001
From: JuggyMcNutty <11588877+JuggyMcNutty@users.noreply.github.com>
Date: Wed, 23 Sep 2026 16:45:15 -0500
Subject: [PATCH] Ray traces: a polygon's plane tested before its vertex count
 and surface

FORK ONLY. This project ships a NO-AI Code Rule asking that LLM-written
changes stay in a fork and are never PR'd upstream. These were written with
Claude. Do not submit them.

TraceRayModel::NodeRayIntersect runs for every node a ray trace visits,
and for every node coplanar with it. It first asked whether the node has
three vertices and whether its surface is solid, then whether the ray
crosses its plane at all. On the handheld, samples put about 40% of the
function's time on those first two questions: the vertex count lies 64
bytes into the node, on another cache line than the plane the traversal
has just read, and the surface's flags are in another array. The plane
tests need only the plane, and turn most nodes away.

They now come first. Every one of these tests returns tmax and nothing
else, so their order changes no result.

Checked with the frame time and random seeds temporarily fixed: a hash of
every actor's location, rotation, velocity, state and class matched the
build before patch 0028, frame by frame, on Liberty Island and UNATCO HQ.
---
 SurrealEngine/Collision/BottomLevel/TraceRayModel.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/SurrealEngine/Collision/BottomLevel/TraceRayModel.cpp b/SurrealEngine/Collision/BottomLevel/TraceRayModel.cpp
index 37bf50a..33a3995 100644
--- a/SurrealEngine/Collision/BottomLevel/TraceRayModel.cpp
+++ b/SurrealEngine/Collision/BottomLevel/TraceRayModel.cpp
@@ -122,8 +122,11 @@ bool TraceRayModel::TraceAnyHit(const dvec3& origin, double tmin, const dvec3& d
 
 double TraceRayModel::NodeRayIntersect(const dvec3& origin, double tmin, const dvec3& dirNormalized, double tmax, BspNode* node, double t0, double t1)
 {
-	if (node->NumVertices < 3 || (node->Surf >= 0 && Model->Surfaces[node->Surf].PolyFlags & PF_NotSolid))
-		return tmax;
+	// The plane tests come first: they read only the node's plane, the part of
+	// it the traversal has just read, and turn away most nodes. Its vertex
+	// count lies on another cache line and its surface's flags in another
+	// array, so on the handheld those two tests were most of the time spent
+	// here. Every test returns tmax, so their order changes nothing else.
 
 	// Test if plane is actually crossed.
 	dvec4 plane = { node->PlaneX, node->PlaneY, node->PlaneZ, -node->PlaneW };
@@ -139,6 +142,9 @@ double TraceRayModel::NodeRayIntersect(const dvec3& origin, double tmin, const d
 	if ((partA > SplitMargin && partB > SplitMargin) || (partA < -SplitMargin && partB < -SplitMargin))
 		return tmax;
 
+	if (node->NumVertices < 3 || (node->Surf >= 0 && Model->Surfaces[node->Surf].PolyFlags & PF_NotSolid))
+		return tmax;
+
 	BspVert* v = &Model->Vertices[node->VertPool];
 	vec3* points = Model->Points.data();
 
