diff --git a/SurrealEngine/Utils/PerfLog.h b/SurrealEngine/Utils/PerfLog.h
new file mode 100644
index 0000000..e9f707c
--- /dev/null
+++ b/SurrealEngine/Utils/PerfLog.h
@@ -0,0 +1,277 @@
+// TEMPORARY DEBUG TOOL -- revert before commit.
+//
+// Frame-time breakdown for profiling on the handheld. With SURREAL_PERF_LOG=1
+// every 60 frames prints, to stderr, where the average frame went: input,
+// game tick, camera/audio, and rendering -- with rendering split into the
+// time the CPU spends waiting on the GPU (fence), on the swapchain (acquire)
+// and on texture uploads. CPU-bound shows as a big tick/render with a small
+// gpu-wait; GPU-bound as a big gpu-wait. A second line splits the render CPU
+// into sections (the top-level frame only: a sky or warp portal's nested frame
+// counts under "portals"), each exclusive of the waits, lightmap builds and
+// texture uploads inside it, with the share spent under script calls.
+//
+// SURREAL_PERF_DETAIL=1 adds tick by actor class and script functions by self
+// time. Those hooks run on every actor tick and every VM call, so they inflate
+// what they measure: leave them off when the frame time itself matters.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <algorithm>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace PerfLog
+{
+	enum Slot { Input, Tick, View, Render, GpuWait, Acquire, UploadWait, Lightmap, TexUpload,
+		// Render sections (Section scopes), then time under top-level VM calls.
+		LightTick, Lock, PreRender, BspInfo, Visibility, Portals, Nodes, Actors, Translucent,
+		Coronas, Overlays, Flash, PostRender, Unlock, VmTop, Count };
+
+	inline bool Enabled()
+	{
+		static int enabled = -1;
+		if (enabled < 0)
+		{
+			const char* v = std::getenv("SURREAL_PERF_LOG");
+			enabled = (v && v[0] == '1') ? 1 : 0;
+		}
+		return enabled == 1;
+	}
+
+	inline bool Detail()
+	{
+		static int detail = -1;
+		if (detail < 0)
+		{
+			const char* v = std::getenv("SURREAL_PERF_DETAIL");
+			detail = (Enabled() && v && v[0] == '1') ? 1 : 0;
+		}
+		return detail == 1;
+	}
+
+	inline uint64_t NowNs()
+	{
+		return (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count();
+	}
+
+	struct State
+	{
+		double sum[Count] = {};
+		double worst[Count] = {};
+		double script[Count] = {};
+		double frameSum = 0.0, frameWorst = 0.0;
+		uint64_t frameStart = 0;
+		int frames = 0;
+	};
+
+	inline State& Get() { static State s; return s; }
+
+	// Actor tick time by class, for finding what the game tick spends its time
+	// on. Keyed by class name; count is ticks, not actors.
+	struct ClassCost { double ms = 0.0; int ticks = 0; };
+	inline std::unordered_map<std::string, ClassCost>& Classes()
+	{
+		static std::unordered_map<std::string, ClassCost> c;
+		return c;
+	}
+	inline void AddClass(const std::string& name, double ms)
+	{
+		ClassCost& c = Classes()[name];
+		c.ms += ms;
+		c.ticks++;
+	}
+
+	// Script and native function cost: self time (callees excluded) and call
+	// count, keyed by the UFunction. A stack of child time gives self time.
+	struct FuncCost { double selfMs = 0.0; int calls = 0; bool native = false; std::string name; };
+	inline std::unordered_map<const void*, FuncCost>& Funcs()
+	{
+		static std::unordered_map<const void*, FuncCost> f;
+		return f;
+	}
+	inline std::vector<double>& ChildStack() { static std::vector<double> s; return s; }
+	inline int& TotalCalls() { static int n; return n; }
+
+	struct FuncScope
+	{
+		const void* key;
+		uint64_t start;
+		FuncScope(const void* k) : key(k), start(Detail() ? NowNs() : 0)
+		{
+			if (start) ChildStack().push_back(0.0);
+		}
+		// Returns true once, the first time a function is seen, so the caller
+		// can supply its name without building a string on every call.
+		template<typename NameFn> void End(bool native, NameFn nameFn)
+		{
+			if (!start) return;
+			double ms = (NowNs() - start) / 1e6;
+			double children = ChildStack().back();
+			ChildStack().pop_back();
+			if (!ChildStack().empty()) ChildStack().back() += ms;
+			FuncCost& c = Funcs()[key];
+			if (c.name.empty()) { c.name = nameFn(); c.native = native; }
+			c.selfMs += ms - children;
+			c.calls++;
+			TotalCalls()++;
+		}
+	};
+
+	// Events per interval: lightmaps rebuilt, textures uploaded.
+	inline int& Counter(int slot) { static int c[Count]; return c[slot]; }
+
+	// SURREAL_PERF_TURN=<aBaseX> makes the player turn on the spot, so a run
+	// with nobody at the pad still brings new surfaces into view.
+	inline float TurnSpeed()
+	{
+		static float speed = -1.0f;
+		if (speed < 0.0f)
+		{
+			const char* v = std::getenv("SURREAL_PERF_TURN");
+			speed = v ? (float)std::atof(v) : 0.0f;
+		}
+		return speed;
+	}
+
+	inline void Add(int slot, double ms)
+	{
+		State& s = Get();
+		s.sum[slot] += ms;
+		if (ms > s.worst[slot]) s.worst[slot] = ms;
+	}
+
+	struct Scope
+	{
+		int slot;
+		uint64_t start;
+		explicit Scope(int s) : slot(s), start(Enabled() ? NowNs() : 0) {}
+		~Scope() { if (start) Add(slot, (NowNs() - start) / 1e6); }
+	};
+
+	// Time inside the outermost Frame::Call only: what script costs, with
+	// everything it calls, without a per-call hook's overhead.
+	inline int& VmDepth() { static int d; return d; }
+	struct VmTopScope
+	{
+		uint64_t start = 0;
+		bool on;
+		VmTopScope() : on(Enabled()) { if (on && VmDepth()++ == 0) start = NowNs(); }
+		~VmTopScope() { if (on) { VmDepth()--; if (start) Add(VmTop, (NowNs() - start) / 1e6); } }
+	};
+
+	// The slots a Section subtracts: they are timed where they happen.
+	inline double Nested()
+	{
+		State& s = Get();
+		return s.sum[GpuWait] + s.sum[Acquire] + s.sum[UploadWait] + s.sum[Lightmap] + s.sum[TexUpload];
+	}
+
+	// A Scope that excludes the Nested() slots inside it and records how much
+	// of it ran under script calls.
+	struct Section
+	{
+		int slot;
+		uint64_t start;
+		double nested = 0.0, vm = 0.0;
+		explicit Section(int s) : slot(s), start(Enabled() ? NowNs() : 0)
+		{
+			if (start) { nested = Nested(); vm = Get().sum[VmTop]; }
+		}
+		~Section()
+		{
+			if (!start) return;
+			State& st = Get();
+			Add(slot, (NowNs() - start) / 1e6 - (Nested() - nested));
+			st.script[slot] += st.sum[VmTop] - vm;
+		}
+	};
+
+	// Called once per main-loop iteration.
+	inline void EndFrame()
+	{
+		if (!Enabled())
+			return;
+		State& s = Get();
+		uint64_t now = NowNs();
+		if (s.frameStart)
+		{
+			double ms = (now - s.frameStart) / 1e6;
+			s.frameSum += ms;
+			if (ms > s.frameWorst) s.frameWorst = ms;
+			s.frames++;
+		}
+		s.frameStart = now;
+
+		if (s.frames < 60)
+			return;
+		double n = s.frames;
+		double avg = s.frameSum / n;
+		std::fprintf(stderr,
+			"perf: %.1f fps | frame %.1f (worst %.1f) | input %.1f | tick %.1f (worst %.1f) | view+audio %.1f | "
+			"render %.1f (worst %.1f): gpu-wait %.1f, acquire %.1f, upload-wait %.1f, "
+			"lightmaps %.1f (%d built), tex-upload %.1f (%d), other-cpu %.1f\n",
+			1000.0 / avg, avg, s.frameWorst, s.sum[Input] / n, s.sum[Tick] / n, s.worst[Tick],
+			s.sum[View] / n, s.sum[Render] / n, s.worst[Render], s.sum[GpuWait] / n,
+			s.sum[Acquire] / n, s.sum[UploadWait] / n,
+			s.sum[Lightmap] / n, Counter(Lightmap), s.sum[TexUpload] / n, Counter(TexUpload),
+			(s.sum[Render] - s.sum[GpuWait] - s.sum[Acquire] - s.sum[UploadWait] -
+			 s.sum[Lightmap] - s.sum[TexUpload]) / n);
+		Counter(Lightmap) = Counter(TexUpload) = 0;
+
+		static const int sections[] = { LightTick, Lock, PreRender, BspInfo, Visibility, Portals, Nodes,
+			Actors, Translucent, Coronas, Overlays, Flash, PostRender, Unlock };
+		static const char* names[] = { "light-tick", "lock", "prerender", "bsp-info", "visibility", "portals",
+			"bsp-surfaces", "actors", "translucent", "coronas", "overlays", "flash", "postrender", "unlock" };
+		double accounted = 0.0;
+		std::fprintf(stderr, "perf: script %.1f (in tick %.1f) | render split, ms excl. waits/lightmaps/uploads (script):",
+			s.sum[VmTop] / n, s.script[Tick] / n);
+		for (size_t i = 0; i < sizeof(sections) / sizeof(*sections); i++)
+		{
+			int slot = sections[i];
+			accounted += s.sum[slot];
+			std::fprintf(stderr, " %s %.1f", names[i], s.sum[slot] / n);
+			if (s.script[slot] >= 0.05 * n)
+				std::fprintf(stderr, " (%.1f)", s.script[slot] / n);
+		}
+		double renderExcl = s.sum[Render] - (s.sum[GpuWait] + s.sum[Acquire] + s.sum[UploadWait] + s.sum[Lightmap] + s.sum[TexUpload]);
+		std::fprintf(stderr, " | rest %.1f | %.0f actors, %.0f bsp nodes drawn\n",
+			(renderExcl - accounted) / n, Counter(Actors) / n, Counter(Nodes) / n);
+		Counter(Actors) = Counter(Nodes) = 0;
+
+		if (!Detail())
+		{
+			std::fflush(stderr);
+			s = State();
+			s.frameStart = now;
+			return;
+		}
+
+		std::vector<std::pair<std::string, ClassCost>> top(Classes().begin(), Classes().end());
+		std::sort(top.begin(), top.end(), [](auto& a, auto& b) { return a.second.ms > b.second.ms; });
+		std::fprintf(stderr, "perf: tick by class (ms/frame, actors):");
+		for (size_t i = 0; i < top.size() && i < 12; i++)
+			std::fprintf(stderr, " %s %.1f (%.0f)", top[i].first.c_str(), top[i].second.ms / n,
+				top[i].second.ticks / n);
+		std::fprintf(stderr, "\n");
+		Classes().clear();
+
+		std::vector<FuncCost> fs;
+		for (auto& it : Funcs()) fs.push_back(it.second);
+		std::sort(fs.begin(), fs.end(), [](auto& a, auto& b) { return a.selfMs > b.selfMs; });
+		std::fprintf(stderr, "perf: %.0f VM calls/frame; top self time (ms/frame, calls/frame):", TotalCalls() / n);
+		for (size_t i = 0; i < fs.size() && i < 20; i++)
+			std::fprintf(stderr, " %s%s %.2f (%.0f)", fs[i].native ? "*" : "", fs[i].name.c_str(),
+				fs[i].selfMs / n, fs[i].calls / n);
+		std::fprintf(stderr, "\n");
+		Funcs().clear();
+		TotalCalls() = 0;
+		std::fflush(stderr);
+		s = State();
+		s.frameStart = now;
+	}
+}
