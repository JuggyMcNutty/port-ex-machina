+	int PlainDataLocals = -1;
+
 	int GetStatementLine(Expression* statement);
 	FunctionDebugInfo* GetDebugInfo();
 
diff --git a/SurrealEngine/VM/Frame.cpp b/SurrealEngine/VM/Frame.cpp
index ec7826c..be0df56 100644
--- a/SurrealEngine/VM/Frame.cpp
