From c4b46f11a49c12a299e55066acd7347502c4f53f Mon Sep 17 00:00:00 2001
From: JuggyMcNutty <11588877+JuggyMcNutty@users.noreply.github.com>
Date: Tue, 22 Sep 2026 22:37:22 -0500
Subject: [PATCH] VM: less work per call -- native frames, events, plain-data
 locals

FORK ONLY. This project ships a NO-AI Code Rule asking that LLM-written
changes stay in a fork and are never PR'd upstream. These were written with
Claude. Do not submit them.

Three costs every script call paid, found by profiling Liberty Island's game
tick on the desktop (perf, dwarf call graphs):

- CallNative built a full Frame for the call stack, and so allocated and
  constructed the native function's locals, which natives never read: they
  get their arguments directly and never Run. Operators alone are thousands
  of native calls a frame. The frame is now built with Frame::NoLocals.
- Frame::Call mapped the function's name to an EventName on every call.
  UFunction::EventIndex keeps the answer; UObject::IsNonEventEnabled is the
  rest of IsEventEnabled(name) for names that are not events.
- LocalVariables constructed and destructed each local with a virtual call.
  When every property of a function is plain data -- numbers, bools, names,
  object references, structs of those, all of which construct to zero
  bytes and destruct to nothing -- the locals are now zero-filled in one go
  and not destructed. UStruct::PlainDataLocals remembers which functions
  qualify.

The tick's share of the desktop profile went from 30% to 26%. Script errors
on Liberty Island: none before, none after.
---
 SurrealEngine/Packages/Core/UFunction.h |  4 ++
 SurrealEngine/Packages/Core/UObject.cpp | 11 +++--
 SurrealEngine/Packages/Core/UObject.h   |  2 +
 SurrealEngine/Packages/Core/UStruct.h   |  4 ++
 SurrealEngine/VM/Frame.cpp              | 62 ++++++++++++++++++++++---
 SurrealEngine/VM/Frame.h                |  5 ++
 6 files changed, 79 insertions(+), 9 deletions(-)

diff --git a/SurrealEngine/Packages/Core/UFunction.h b/SurrealEngine/Packages/Core/UFunction.h
index bc4e0ee..385f065 100644
--- a/SurrealEngine/Packages/Core/UFunction.h
+++ b/SurrealEngine/Packages/Core/UFunction.h
@@ -45,4 +45,8 @@ public:
 	uint16_t ReplicationOffset = 0;
 
 	UStruct* NativeStruct = nullptr;
+
+	// Frame::Call's NameStringToEventName(Name), done once: the EventName, or
+	// -1 when the function is not an event, or -2 before the first call.
+	int EventIndex = -2;
 };
diff --git a/SurrealEngine/Packages/Core/UObject.cpp b/SurrealEngine/Packages/Core/UObject.cpp
index 2b855f3..b855e7c 100644
--- a/SurrealEngine/Packages/Core/UObject.cpp
+++ b/SurrealEngine/Packages/Core/UObject.cpp
@@ -376,12 +376,17 @@ bool UObject::IsEventEnabled(const NameString& name) const
 	}
 	else
 	{
-		NameString stateName = GetStateName();
-		auto it = DisabledEvents.find(stateName);
-		return it == DisabledEvents.end() || it->second.find(name) == it->second.end();
+		return IsNonEventEnabled(name);
 	}
 }
 
+bool UObject::IsNonEventEnabled(const NameString& name) const
+{
+	NameString stateName = GetStateName();
+	auto it = DisabledEvents.find(stateName);
+	return it == DisabledEvents.end() || it->second.find(name) == it->second.end();
+}
+
 bool UObject::IsEventEnabled(EventName name) const
 {
 	int nameIndex = (int)name;
diff --git a/SurrealEngine/Packages/Core/UObject.h b/SurrealEngine/Packages/Core/UObject.h
