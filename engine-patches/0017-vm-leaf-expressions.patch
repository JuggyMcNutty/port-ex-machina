From 51d45aa37c96a9bc5656d4ce5d89992e94fa8d13 Mon Sep 17 00:00:00 2001
From: JuggyMcNutty <11588877+JuggyMcNutty@users.noreply.github.com>
Date: Wed, 23 Sep 2026 10:12:46 -0500
Subject: [PATCH] VM: the commonest leaf expressions made without the visitor

FORK ONLY. This project ships a NO-AI Code Rule asking that LLM-written
changes stay in a fork and are never PR'd upstream. These were written with
Claude. Do not submit them.

About half the expressions the evaluator meets are leaves: local, instance
and bool variables, Self, None, and object, name, int, byte, float and
bool constants. Each still went through the visitor's two indirect calls,
set Frame::StepExpression and handed its value up by assignment.

Expression::Leaf tags those node types, and ExpressionEvaluator::Value
makes their values directly, exactly as their Expr functions make them.
None of them can throw, so none needs to be the StepExpression the
debugger would show. Everything else takes the visitor as before
(ExpressionEvaluator::VisitValue).

Liberty Island's log is the same as before.
---
 SurrealEngine/VM/Expression.h            | 24 ++++++++++++++++++++++
 SurrealEngine/VM/ExpressionEvaluator.cpp | 26 ++++++++++++++++++++++++
 SurrealEngine/VM/ExpressionEvaluator.h   |  1 +
 3 files changed, 51 insertions(+)

diff --git a/SurrealEngine/VM/Expression.h b/SurrealEngine/VM/Expression.h
index 0b63c5f..08bf3bd 100644
--- a/SurrealEngine/VM/Expression.h
+++ b/SurrealEngine/VM/Expression.h
@@ -16,11 +16,21 @@ public:
 	virtual void Visit(ExpressionVisitor* visitor) = 0;
 
 	int StatementIndex = -1;
+
+	// The leaves ExpressionEvaluator::Value makes without the visitor: about
+	// half of all expressions evaluated. Everything else is Other.
+	enum class LeafKind : uint8_t
+	{
+		Other, LocalVariable, InstanceVariable, BoolVariable, Self, NoObject, ObjectConst, NameConst,
+		IntConst, IntZero, IntOne, IntConstByte, ByteConst, FloatConst, True, False
+	};
+	LeafKind Leaf = LeafKind::Other;
 };
 
 class LocalVariableExpression : public Expression
 {
 public:
+	LocalVariableExpression() { Leaf = LeafKind::LocalVariable; }
 	void Visit(ExpressionVisitor* visitor) override { visitor->Expr(this); }
 
 	UProperty* Variable = nullptr;
@@ -29,6 +39,7 @@ public:
 class InstanceVariableExpression : public Expression
 {
