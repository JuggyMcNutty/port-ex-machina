# Build output: every port builds under build/<port>/{launcher,engine,app}
/build/

# Fetched, not versioned: cross toolchains and device sysroots (scripts/dx.sh deps)
/deps/

# Not ours, each for its own reason:
#   engine/     a clone of VibeEngine, the engine fork (scripts/engine.sh fetch)
#   launcher/   deusex-launcher: its main, and a worktree per port branch (scripts/launcher.sh fetch)
#   re/         a clone of dx-reverse-info, the original binaries' RE (scripts/dx.sh fetch)
#   gamefiles/  your own Deus Ex install -- never commit it
#   reference/  the 1112f SDK, the DeusExe source, IDA and ini backups
/engine/
/launcher/
/re/
/gamefiles/
/reference/

# Game data anywhere else -- never commit. The user supplies their own copy.
*.u
*.utx
*.uax
*.umx
*.unr
*.dts
*.exe
*.dll

# Loose build products
*.o
*.a
*.so
*.so.*

# Editor / OS / local tool state
/.claude/settings.local.json
.cache/
compile_commands.json
*.swp
.DS_Store
__pycache__/
